# Copy to .env for local development. Do not commit .env.
DATA_DIR=./data
VAULT_IDLE_SECONDS=900
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Optional local OpenAI-compatible inference server (e.g. llama.cpp).
MODEL_BASE_URL=http://127.0.0.1:10080/v1
MODEL_NAME=smolvlm
MODEL_API_KEY=local-development
MODEL_ALLOW_REMOTE=false
MODEL_CONTEXT_FALLBACK=4096
MODEL_PROMPT_FRACTION=0.80
MODEL_ANSWER_MAX_TOKENS=320
